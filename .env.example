# docker-compose uchun muhit o'zgaruvchilari.
# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring.
# .env gitga qo'shilmaydi (.gitignore).

# Production uchun DEBUG=False qo'ying
DEBUG=False

# Kuchli, tasodifiy kalit (masalan: python -c "import secrets;print(secrets.token_urlsafe(50))")
SECRET_KEY=CHANGE_ME_strong_random_secret_key

# Server domeni/IP manzillari (vergul bilan)
ALLOWED_HOSTS=185.241.151.30,localhost,127.0.0.1,backend

# HTTPS yoki nostandart port orqali kiriladigan manbalar
CSRF_TRUSTED_ORIGINS=http://185.241.151.30:3002

# Frontend manbasi (CORS)
CORS_ALLOWED_ORIGINS=http://185.241.151.30:3002,http://localhost:3002

# Database
DB_NAME=aviakassa_db
DB_USER=aviakassa_user
DB_PASSWORD=CHANGE_ME_strong_db_password
